:{$PORT:3000} {
    encode zstd gzip

    @health path /health
    handle @health {
        respond "ok" 200
    }

    # Login-free public landing only. Never expose the uninitialized n8n owner's
    # setup, credentials, workflows, execution history or management endpoints.
    @landing {
        method GET HEAD
        path / /index.html
    }
    handle @landing {
        redir https://investment-n8n-operations-ui-production.up.railway.app/ 302
    }

    # Deliberately no basic_auth and no WWW-Authenticate challenges.
    # The original n8n server remains private inside Railway until owner
    # setup is completed. This endpoint is not a public n8n editor.
    handle {
        respond "Native n8n administration is private. Open the public simulation dashboard." 403
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control "no-store"
        -Server
        -WWW-Authenticate
    }
}
