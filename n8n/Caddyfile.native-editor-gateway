:{$PORT:3000} {
    encode zstd gzip
    @health path /health
    handle @health {
        respond "ok" 200
    }

    @landing path / /index.html
    handle @landing {
        root * /srv/site
        rewrite * /index.html
        file_server
    }

    handle_path /demo-data/* {
        root * /srv/data
        file_server
    }

    # Original Vue editor assets and API for the isolated preview-only n8n.
    # No separate React graph, no Basic Auth, no n8n owner setup endpoints.
    @originalN8n {
        method GET HEAD
        path /workflows/demo /assets/* /static/* /types/* /rest/* /favicon.ico /favicon.png /icons/* /node-icons/*
    }
    handle @originalN8n {
        reverse_proxy http://investment-n8n-source-editor.railway.internal:5678 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }

    handle {
        respond "이 주소는 원본 n8n 노드 캔버스 조회 및 합성 테스트 전용입니다." 403
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control "no-store"
        -WWW-Authenticate
    }
}
