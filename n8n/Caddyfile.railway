:{$PORT:3000} {
  encode gzip
  @health path /health
  respond @health "ok" 200
  # Public test UI: no username/password login challenge.
  @api path /studio-api/*
  handle @api {
    uri strip_prefix /studio-api
    reverse_proxy {$INVESTMENT_BACKEND_UPSTREAM} {
      header_up Authorization "Bearer {$ALPHA_NODE_API_KEY}"
      header_up -Cookie
    }
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    -Server
  }
}
