:{$PORT:3000} {
    encode gzip

    @health path /health
    handle @health {
        respond "ok" 200
    }

    # Public TEST dashboard: only specifically enumerated read-only endpoints.
    # Authorization stays on the server; never expose the upstream bearer token.
    @publicOps {
        method GET
        path /studio-api/api/v1/ops/overview /studio-api/api/v1/ops/strategies /studio-api/api/v1/ops/agents /studio-api/api/v1/ops/audit/findings /studio-api/api/v1/ops/events
    }
    @publicScenarioRead {
        method GET
        path /studio-api/api/v1/alpha/scenarios /studio-api/api/v1/alpha/scenarios/infra /studio-api/api/v1/alpha/scenarios/*
    }
    @publicScenarioSimulation {
        method POST
        path_regexp synthetic ^/studio-api/api/v1/alpha/scenarios/[^/]+/runs$
    }

    # Exactly the ten synthetic scenarios may be dispatched via the REAL private
    # n8n webhook. The backend validates the scenario ID and never places orders.
    @publicN8nSimulation {
        method POST
        path_regexp n8nsim ^/studio-api/api/v1/alpha/scenarios/(01-new-strategy|02-version-update|03-capital-race|04-partial-fill|05-long-backtest|06-strategy-drift|07-broker-timeout|08-agent-crash|09-unsupported-pine|10-strategy-retire)/dispatch$
    }

    @api path /studio-api/*
    handle @api {
        route {
            # Evaluate the explicit matchers before the authenticated fallback.
            handle @publicOps {
                uri strip_prefix /studio-api
                reverse_proxy {$INVESTMENT_BACKEND_UPSTREAM} {
                    header_up Authorization "Bearer {$ALPHA_NODE_API_KEY}"
                    header_up -Cookie
                }
            }
            handle @publicScenarioRead {
                uri strip_prefix /studio-api
                reverse_proxy {$INVESTMENT_BACKEND_UPSTREAM} {
                    header_up Authorization "Bearer {$ALPHA_NODE_API_KEY}"
                    header_up -Cookie
                }
            }
            handle @publicScenarioSimulation {
                uri strip_prefix /studio-api
                reverse_proxy {$INVESTMENT_BACKEND_UPSTREAM} {
                    header_up Authorization "Bearer {$ALPHA_NODE_API_KEY}"
                    header_up -Cookie
                }
            }
            handle @publicN8nSimulation {
                uri strip_prefix /studio-api
                reverse_proxy {$INVESTMENT_BACKEND_UPSTREAM} {
                    header_up Authorization "Bearer {$ALPHA_NODE_API_KEY}"
                    header_up -Cookie
                }
            }
            # All mutating trading/admin actions are unavailable in the public demo.
            handle {
                respond "Forbidden: demo endpoints only" 403
            }
        }
    }

    # Web application is visible without the test-stage username/password.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
        Cache-Control "no-store"
    }
}
