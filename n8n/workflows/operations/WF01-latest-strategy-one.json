        "jsCode": "return $input.all().map(({json:p})=>{if(p.kind!=='strategy'||p.source_saved!==true||p.status!=='PINE_SAVED_CONVERSION_PENDING')throw Error('PINE_NOT_SAVED');return {json:{kind:p.kind,status:'PINE_SAVED_CONVERSION_PENDING',source_id:p.source_id,version_key:p.version_key,saved_count:p.saved_count,rights_state:'PENDING_REVIEW',conversion_validated:false,tradingview_chart_validated:false,paper_enabled:false,live_orders_enabled:false}};});",
