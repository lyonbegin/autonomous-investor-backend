      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(({json:p})=>{if(p.kind!=='strategy'||!['IMPORTED','ALREADY_IMPORTED'].includes(p.status))throw Error('IMPORT_NOT_CONFIRMED');return {json:{kind:'strategy',status:p.status,saved_count:p.status==='IMPORTED'?1:0,source_id:p.source_id,version_key:p.version_key,sha256:p.sha256||null,rights_state:p.rights_state||'PENDING_REVIEW',imported_at:p.imported_at||null}};});"
      },
      "notes": ""
