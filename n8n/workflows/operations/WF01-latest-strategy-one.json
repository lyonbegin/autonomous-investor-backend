        "jsCode": "return $input.all().map(({json:p})=>({json:{kind:p.kind,page:p.next_page,max_pages:p.max_pages,page_size:p.page_size||50,sort:'recent_extended',max_detail_success:1,selected_count:0,tradingview_requested:false,next_node_executed:false}}));",
