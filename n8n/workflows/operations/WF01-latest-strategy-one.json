      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(({json:r})=>{if(r.kind!=='strategy'||r.status!=='ok'||!Array.isArray(r.items))throw Error('N04_UPSTREAM_CATALOG_INVALID');const seen=new Set();let duplicates=0;const candidates=[];for(const item of r.items){if(item.kind!=='strategy'||typeof item.source_id!=='string'||typeof item.version_key!=='string'||!String(item.source_url||'').startsWith('https://www.tradingview.com/script/'))throw Error('N04_ITEM_INVALID');const key=item.source_id+'#'+item.version_key;if(seen.has(key)){duplicates++;continue;}seen.add(key);candidates.push({...item});}const live=r.catalog_is_live===true;candidates.sort((a,b)=>String(live?b.updated_at||'':b.catalog_observed_at||'').localeCompare(String(live?a.updated_at||'':a.catalog_observed_at||''))||String(b.source_id).localeCompare(String(a.source_id)));return {json:{...r,candidates,candidate_count:candidates.length,duplicates_removed:duplicates,next_page:r.has_more&&r.page<r.max_pages?r.page+1:null,latest_tradingview_checked:live,validated_catalog_is_snapshot:!live,candidate_sort_basis:live?'updated_at_from_live_provider':'third_party_manifest_observed_at',source:'project_approved_catalog_validation'}};});",
        "studioPython": {
          "python_module": "investment_node_adapter",
          "python_function": "execute_node04",
          "code_version": "wf01-n04-v2-pine-metadata",
          "node_character": "validated_catalog_candidates"
        }
