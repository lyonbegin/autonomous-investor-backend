        "jsCode": "return $input.all().map(({json:r})=>{if(r.kind!=='library'||r.source_registry_checked!==true||!Array.isArray(r.items))throw Error('N06_N05_REGISTRY_OUTPUT_INVALID');const first=r.items.find(x=>x.kind==='library'&&x.imported===false&&typeof x.source_id==='string'&&typeof x.version_key==='string'&&String(x.source_url||'').startsWith('https://www.tradingview.com/script/'));const can=Number.isInteger(r.next_page)&&r.next_page>r.page&&r.next_page<=r.max_pages;return {json:{...r,candidate:first??null,has_candidate:!!first,selected_candidate_count:first?1:0,can_continue:can,pine_source_acquired:false,candidate_selection_basis:r.candidate_sort_basis??'unknown'}};});",
