        "jsCode": "return $input.all().map(({json:p})=>{const valid=/^[A-Za-z0-9_-]{3,80}$/.test(p.source_id||'')&&Number.isInteger(p.version)&&p.version>0&&/^[a-f0-9]{64}$/i.test(p.sha256||'');return {json:{...p,manifest_valid:valid}};});"
