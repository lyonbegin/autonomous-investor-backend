      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        690,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(item=>{const p=item.json;const required=['source_id','script_type','pine_version','source_code','author','rights_evidence'];return {json:{...p,valid:required.every(k=>Boolean(p[k])),validation_source:'WF01'}}});"
      },
      "notes": ""
    },
    {
      "id": "check-fields",
      "name": "필수 정보 있나?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        970,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{$json.valid}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "notes": ""
    },
    {
