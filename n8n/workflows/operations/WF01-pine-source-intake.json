      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{source_id:'DEMO_STRATEGY',script_type:'strategy',pine_version:6,source_code:'//@version=6\\nstrategy(\"Example\")\\nplot(close)',author:'authorized-user',rights_evidence:'DEMO ONLY - human review required'}}];"
      },
      "notes": ""
    },
    {
      "id": "필수 필드 검사",
