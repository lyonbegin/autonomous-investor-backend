        "jsCode": "return $input.all().map(({json:p})=>{const errors=[];if(typeof p.source_id!=='string'||!/^[A-Za-z0-9_-]{3,80}$/.test(p.source_id)) errors.push('source_id');if(!['indicator','strategy','library'].includes(p.script_type))errors.push('script_type');if(!Number.isInteger(p.pine_version)||p.pine_version<1||p.pine_version>6)errors.push('pine_version');if(typeof p.source_code!=='string'||p.source_code.length<10||p.source_code.length>300000)errors.push('source_code');if(typeof p.author!=='string'||!p.author.trim()||p.author.length>200)errors.push('author');if(typeof p.rights_evidence!=='string'||p.rights_evidence.length<10)errors.push('rights_evidence');if(p.source_url!=null&&p.source_url!==''&&!/^https:\\/\\/[^/]+/.test(p.source_url))errors.push('source_url');return {json:{...p,validation_ok:errors.length===0,validation_errors:errors}};});"
      },
      "notes": ""
    },
