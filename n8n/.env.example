# Copy to n8n/.env ON YOUR OWN HOST. Never commit n8n/.env.
# Use strong, different random values: openssl rand -hex 32
N8N_DB_PASSWORD=REPLACE_WITH_32_BYTE_RANDOM
N8N_REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_32_BYTE_RANDOM
N8N_ENCRYPTION_KEY=REPLACE_WITH_FIXED_32_BYTE_RANDOM_KEEP_FOR_RESTORES
ALPHA_NODE_API_KEY=REPLACE_WITH_DIFFERENT_32_BYTE_RANDOM

# Set DNS A/AAAA before enabling public TLS.
INVESTMENT_DOMAIN=invest.example.com
INVESTMENT_ADMIN_USER=operator
# Hash only. Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'YOUR_LONG_UNIQUE_PASSWORD'
# Quote with single quotes to preserve bcrypt '$' signs in .env.
INVESTMENT_ADMIN_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
# Only if your OWN upstream collector is explicitly configured and authorized.
ALPHA_TRADINGVIEW_BASE=
ALPHA_TRADINGVIEW_TOKEN=

# VPS public binding. Private n8n admin remains at 127.0.0.1:5678 via SSH port forward.
INVESTMENT_HTTP_PORT=80
INVESTMENT_HTTPS_PORT=443
