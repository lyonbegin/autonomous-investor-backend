FROM python:3.12-slim
WORKDIR /srv
COPY n8n/pine-parity/engine.py n8n/pine-parity/server.py n8n/pine-parity/index.html n8n/pine-parity/app.js ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PARITY_STORAGE=/data/parity
RUN python -m py_compile engine.py server.py
EXPOSE 3000
CMD ["python","-u","server.py"]
