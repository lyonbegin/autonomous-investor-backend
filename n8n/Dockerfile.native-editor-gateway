# ONE shared-n8n-studio editor, imported from its pinned GitHub commit.
# Project-specific input = original investment workflow JSON data.
# No trading, brokerage or n8n execution. Only registered stock WF01 N01 and N02 Python test nodes run.
FROM node:22-alpine AS build
RUN apk add --no-cache git
WORKDIR /app
ARG SHARED_STUDIO_COMMIT=1f7359d84b7ec02796dc0477fd1be0363837fc15
RUN git clone https://github.com/lyonbegin/shared-n8n-studio.git /app/shared \
    && git -C /app/shared checkout --detach "$SHARED_STUDIO_COMMIT" \
    && test "$(git -C /app/shared rev-parse HEAD)" = "$SHARED_STUDIO_COMMIT"
RUN npm install --prefix /app/shared/playground --no-audit --no-fund
COPY n8n/workflows/ /app/shared/playground/public/stock-workflows/
ENV VITE_EDITOR_PROJECT=investment
RUN npm --prefix /app/shared/playground run build
# Compile-check the REAL final administrator UI inline script at image build.
COPY n8n/admin-console/index.html /app/n8n/admin-console/index.html
COPY n8n/tests/test_verified_admin_static.cjs /app/n8n/tests/test_verified_admin_static.cjs
RUN node /app/n8n/tests/test_verified_admin_static.cjs


# Migrate ONLY the existing /scripts React UI and all its original child pages
# into this SAME editor/operations service. Pin precisely the last known-good
# public frontend with Vela/Pine vs Python 300-bar verified viewport sync.
# The old standalone public service can be removed after live E2E.
FROM node:22-alpine AS approved_scripts_build
RUN apk add --no-cache git
ARG VERIFIED_SCRIPTS_REACT_COMMIT=1c26e090ee1ffcc8b549f70df843d4e2fa616d4f
RUN git clone --depth 1 --branch feature/ddds-synchronized-visible-interval-20261104 \
      https://github.com/lyonbegin/autonomous-investor-backend.git /app/verified-repo \
 && git -C /app/verified-repo fetch --depth 1 origin "$VERIFIED_SCRIPTS_REACT_COMMIT" \
 && git -C /app/verified-repo checkout --detach "$VERIFIED_SCRIPTS_REACT_COMMIT" \
 && test "$(git -C /app/verified-repo rev-parse HEAD)" = "$VERIFIED_SCRIPTS_REACT_COMMIT"
WORKDIR /app/verified-repo/public_frontend
COPY n8n/verified-ui/VerifiedScriptsApp.tsx ./src/VerifiedScriptsApp.tsx
COPY n8n/verified-ui/main.tsx ./src/main.tsx
COPY n8n/verified-ui/vite.config.ts ./vite.config.ts
RUN npm install --no-audit --no-fund && npm run build

# Persistent, isolated per-browser SQLite drafts. Public demo write operations
# cannot trigger n8n, TradingView or broker; N01 Python selection-only is allowlisted.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "psycopg[binary]>=3.2,<4" "pynesys-pynecore==6.11.1" "beautifulsoup4==4.13.4" "hoox-pyne[compile]==0.6.31"
WORKDIR /app
COPY --from=build /app/shared/playground/dist /app/dist
COPY --from=approved_scripts_build /app/verified-repo/public_frontend/dist /app/dist/verified
COPY n8n/admin-console/index.html /app/dist/admin/index.html
COPY n8n/admin-console/markets.html /app/dist/admin/markets.html
COPY n8n/admin-console/markets-chart.js /app/dist/admin/markets-chart.js
RUN python3 -c 'from pathlib import Path; p=Path("/app/dist/admin/index.html"); s=p.read_text(); needle="</body>"; assert needle in s; s=s.replace(needle,"<a href=\"/admin/markets.html\" style=\"position:fixed;bottom:20px;right:20px;z-index:100;background:#2563eb;color:#fff;padding:12px 16px;border-radius:8px;text-decoration:none;font:600 13px sans-serif;box-shadow:0 6px 16px #0008\">마켓 보기 ↗</a>"+needle); p.write_text(s)' 
RUN python3 -c 'from pathlib import Path; s=Path("/app/dist/admin/markets.html").read_text(); assert all(x in s for x in ("모든 곳의 시장","한국 주식","세계 주식","회사채","경제","mountChart","openDetail"))'
RUN python3 -c 'from pathlib import Path; p=Path("/app/dist/index.html"); s=p.read_text(); link="<a href=\"/admin/index.html\" style=\"position:fixed;bottom:18px;right:18px;z-index:9999;background:#165e9b;color:white;text-decoration:none;padding:12px 16px;border-radius:9px;box-shadow:0 6px 22px #0004;font:600 13px sans-serif\" aria-label=\"주식 자동화 종합 관제센터\">종합 관제센터 ↗</a>"; assert "</body>" in s; p.write_text(s.replace("</body>",link+"</body>"))'
COPY --from=build /app/shared/server/studio_server.py /app/studio_server.py
COPY --from=build /app/shared/server/node_run_store.py /app/node_run_store.py
COPY --from=build /app/shared/server/project_adapter_runtime.py /app/project_adapter_runtime.py
COPY n8n/editor-adapter/investment_node_adapter.py /app/investment_node_adapter.py
COPY n8n/editor-adapter/investment_wf02.py /app/investment_wf02.py
COPY n8n/editor-adapter/investment_pynecomp.py /app/investment_pynecomp.py
COPY n8n/editor-adapter/investment_free_pyne.py /app/investment_free_pyne.py
COPY n8n/editor-adapter/investment_free_pyne_runner.py /app/investment_free_pyne_runner.py
COPY n8n/editor-adapter/investment_free_pyne_chart.py /app/investment_free_pyne_chart.py
COPY n8n/editor-adapter/investment_shared_bars_compare.py /app/investment_shared_bars_compare.py
COPY n8n/editor-adapter/investment_verified_catalog.py /app/investment_verified_catalog.py
COPY n8n/investment-db/investment_pg.py /app/investment_pg.py
COPY n8n/investment-db/schema_v1.sql /app/schema_v1.sql
COPY n8n/editor-adapter/investment_pipeline.py /app/investment_pipeline.py
COPY n8n/editor-adapter/investment_pipeline_ddds_bridge.py /app/investment_pipeline_ddds_bridge.py
COPY n8n/editor-adapter/investment_studio_server.py /app/investment_studio_server.py
COPY n8n/editor-adapter/investment_tv_chart_integration.py /app/investment_tv_chart_integration.py
COPY n8n/editor-adapter/investment_tv_publication.py /app/investment_tv_publication.py
COPY n8n/editor-adapter/investment_tv_trade_reference.py /app/investment_tv_trade_reference.py
COPY n8n/editor-adapter/investment_ddds_parity.py /app/investment_ddds_parity.py
COPY n8n/editor-adapter/fixtures/ddds_published_source.gz.b64 /app/fixtures/ddds_published_source.gz.b64
COPY n8n/editor-adapter/fixtures/ddds_verified_public_properties_20261103.json /app/fixtures/ddds_verified_public_properties_20261103.json
COPY n8n/pine-parity/demo/bollinger_bands.py n8n/pine-parity/demo/sma_crossover.py /app/pynecore_samples/
COPY n8n/pine-parity/engine.py /app/engine.py
COPY n8n/pine-parity/sequence_reversal.py /app/sequence_reversal.py
COPY n8n/editor-adapter/licensed_strategy_manifest.py /app/licensed_strategy_manifest.py
COPY n8n/editor-adapter/investment_source_registry.py /app/investment_source_registry.py
COPY n8n/editor-adapter/verified_pine_archive.py /app/verified_pine_archive.py
COPY n8n/editor-adapter/verified_pine_archive_index.json /app/verified_pine_archive_index.json
COPY n8n/editor-adapter/investment_pine_store.py /app/investment_pine_store.py
COPY --from=build /app/shared/server/node_workspace_store.py /app/node_workspace_store.py
RUN python3 -m py_compile /app/studio_server.py /app/node_workspace_store.py /app/node_run_store.py /app/project_adapter_runtime.py /app/investment_node_adapter.py /app/investment_wf02.py /app/investment_pynecomp.py /app/investment_free_pyne.py /app/investment_free_pyne_runner.py /app/investment_free_pyne_chart.py /app/investment_shared_bars_compare.py /app/investment_verified_catalog.py /app/investment_pg.py /app/investment_pipeline.py /app/investment_pipeline_ddds_bridge.py /app/investment_studio_server.py /app/investment_tv_chart_integration.py /app/investment_tv_publication.py /app/investment_tv_trade_reference.py /app/investment_ddds_parity.py /app/pynecore_samples/bollinger_bands.py /app/pynecore_samples/sma_crossover.py /app/engine.py /app/sequence_reversal.py /app/licensed_strategy_manifest.py /app/investment_source_registry.py /app/verified_pine_archive.py

# Fail deployment before it starts if a promotion could leak an unverified
# strategy or break the existing persistent ledger/idempotency guarantees.
COPY n8n/tests/test_verified_strategy_catalog.py /app/verified_tests/test_verified_strategy_catalog.py
RUN DDDS_FIXTURE_PATH=/app/fixtures/ddds_published_source.gz.b64 \
    PYTHONPATH=/app python3 /app/verified_tests/test_verified_strategy_catalog.py -v
COPY n8n/tests/test_ddds_integrated_bridge.py /app/verified_tests/test_ddds_integrated_bridge.py
RUN PYTHONPATH=/app python3 /app/verified_tests/test_ddds_integrated_bridge.py -v
RUN mkdir -p /data && groupadd --system studio && useradd --system --gid studio --home /app studio \
    && chown -R studio:studio /data /app
# The Railway volume is mounted after image build as root-owned /data.
# Fix only the dedicated draft directory before dropping to the studio user.
ENV PORT=3000
ENV STUDIO_STATIC_ROOT=/app/dist
ENV STUDIO_DB_PATH=/data/studio.sqlite3
ENV STUDIO_PROJECT_ADAPTER=investment_node_adapter
# Boot the actual packaged server with an isolated temp DB. Verify HTTP
# routes and that an unverified source cannot be published on a same-origin POST.
COPY n8n/tests/smoke_verified_http.py /app/verified_tests/smoke_verified_http.py
RUN python3 /app/verified_tests/smoke_verified_http.py
EXPOSE 3000
CMD ["sh", "-c", "chown -R studio:studio /data && gosu studio python3 -c 'import investment_pipeline; investment_pipeline.init()' && if [ -n \"${INVESTMENT_DATABASE_URL:-}\" ]; then gosu studio python3 -u /app/investment_pg.py || exit 1; fi && exec gosu studio python3 -u /app/investment_studio_server.py"]
