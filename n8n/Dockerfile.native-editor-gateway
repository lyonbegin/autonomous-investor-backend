# Stock-facing editor now uses the ONE common shared-n8n-studio Vue module.
# Original stock n8n workflow JSONs are input data, not a second editor implementation.
# This image exposes no broker/credential/investment-run endpoints.
FROM node:22-alpine AS build
RUN apk add --no-cache git
WORKDIR /app
ARG SHARED_STUDIO_COMMIT=4cc1a72fb5185c904a072747cdd235fe21a48321
RUN git clone https://github.com/lyonbegin/shared-n8n-studio.git /app/shared \
    && git -C /app/shared checkout --detach "$SHARED_STUDIO_COMMIT" \
    && test "$(git -C /app/shared rev-parse HEAD)" = "$SHARED_STUDIO_COMMIT"
RUN npm install --prefix /app/shared/playground --no-audit --no-fund
COPY n8n/workflows/ /app/shared/playground/public/stock-workflows/
ENV VITE_EDITOR_PROJECT=investment
RUN npm --prefix /app/shared/playground run build
FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/shared/playground/dist ./dist
COPY --from=build /app/shared/playground/server.mjs ./server.mjs
ENV PORT=3000
EXPOSE 3000
CMD ["node","server.mjs"]
